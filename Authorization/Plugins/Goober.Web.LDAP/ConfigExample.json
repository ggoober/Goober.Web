        //"ForwardForbid": null,
        //"ForwardSignIn": null,
        //"ForwardSignOut": null,
        "Cookie": {
          //  "Name": null,
          "Path": "/",
          //  "Domain": null,
          //  "HttpOnly": true,
          "SameSite": 1,
          //  "SecurePolicy": 0,
          //  "Expiration": null,
          //  "MaxAge": null,
          "IsEssential": true
        }
      }
